# ─── AWS ────────────────────────────────────────────────────────────────────
AWS_REGION=us-east-1
ECS_CLUSTER_NAME=tangent
ECR_REPO_NAME=tangent
LOG_GROUP_NAME=/ecs/tangent

# ─── ECS Task Defaults ───────────────────────────────────────────────────────
TASK_CPU=512
TASK_MEMORY=1024
DEFAULT_APP_PORT=8080

# ─── Fargate Networking ──────────────────────────────────────────────────────
FARGATE_SUBNETS=subnet-XXXXX,subnet-YYYYY
FARGATE_SECURITY_GROUP=sg-XXXXX
FARGATE_ASSIGN_PUBLIC_IP=ENABLED

# ─── IAM ─────────────────────────────────────────────────────────────────────
ECS_EXECUTION_ROLE_ARN=arn:aws:iam::123456789012:role/tangent-ecs-execution
ECS_TASK_ROLE_ARN=arn:aws:iam::123456789012:role/tangent-ecs-task

# ─── Secrets Manager Keys ────────────────────────────────────────────────────
# These are the SECRET NAMES in AWS Secrets Manager, not the actual values.
# Tangent fetches the real values from Secrets Manager at startup.
SECRET_NGROK_AUTHTOKEN=tangent/ngrok-authtoken
SECRET_GITHUB_TOKEN=tangent/github-token
SECRET_ANTHROPIC_KEY=tangent/ANTHROPIC_API_KEY
SECRET_SLACK_APP_TOKEN=tangent/slack-app-token
SECRET_SLACK_TOKEN=tangent/slack-bot-token
SECRET_DASHBOARD_PASSWORD=tangent/dashboard-password

# ─── Tangent Runtime Policy / Env Handling ─────────────────────────────────
NGROK_OAUTH_DOMAINS=impiricus.com,docupdate.io
SECRETS_MANAGER_PREFIX=tangent/
SHARED_APP_SECRETS=ANTHROPIC_API_KEY=arn:aws:secretsmanager:us-east-1:123456789012:secret:tangent/ANTHROPIC_API_KEY-xxxxxx
NGROK_AUTHTOKEN_SECRET_VALUE_FROM=arn:aws:secretsmanager:us-east-1:123456789012:secret:tangent/ngrok-authtoken-xxxxxx
TANGENT_DB_HOST_INTERNAL_IP=10.40.40.123

# ─── Slack ───────────────────────────────────────────────────────────────────
SLACK_CHANNEL=#ai-engineering
# Comma-separated Slack member IDs allowed to control Tangent.
# Find via: profile → ⋮ → Copy member ID (starts with U or W).
# Leave blank to allow everyone.
ALLOWED_SLACK_USER_IDS=U012AB3CD,U098ZY7WX

# ─── GitHub ──────────────────────────────────────────────────────────────────
GITHUB_ORG=impiricus
SCAFFOLD_CHILD_TOPIC=impiricus-scaffold-child

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=3000
HOST=127.0.0.1
DASHBOARD_USERNAME=daanish
# Optional alternative to SECRET_DASHBOARD_PASSWORD for local/dev use.
DASHBOARD_PASSWORD=change-me
# Optional bearer token for scripted mutation routes.
DASHBOARD_API_TOKEN=

# ─── Workspace ───────────────────────────────────────────────────────────────
# Temporary directory for git clones and docker builds.
# Cleaned up after each build.
WORKSPACE_DIR=/home/ubuntu/tangent-workspace
